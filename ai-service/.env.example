PORT=8000
DATABASE_URL=postgresql://codepilot:codepilot@localhost:5432/codepilot

EMBEDDING_PROVIDER=local
EMBEDDING_DIM=1536
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# AI_PROVIDER selects which LLM answers Q&A/PR-review/onboarding: "anthropic" (default),
# "gemini", or "ollama" (a model running entirely on your own machine via https://ollama.com --
# no API key, no external network call, no per-request cost or quota). Only the selected
# provider's settings need to be set.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# `brew install ollama && ollama serve && ollama pull qwen2.5:7b-instruct`, then AI_PROVIDER=ollama.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
