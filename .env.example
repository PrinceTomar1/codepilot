# Copy this file to .env and fill in real values before running `docker compose up`.
# docker-compose.yml reads these to configure the backend and ai-service containers.

# --- AI / RAG service ---------------------------------------------------------
# "local" needs no key and works out of the box (hashing-based embeddings).
# "openai" gives real semantic embeddings (text-embedding-3-small, 1536-dim).
EMBEDDING_PROVIDER=local
OPENAI_API_KEY=

# Required for Q&A answers, PR review agents, and onboarding-doc generation.
# Without a key for the selected AI_PROVIDER, indexing/retrieval still work,
# but generation endpoints return a clear 503 instead of an answer.
# AI_PROVIDER selects which one is used: "anthropic" (default), "gemini", or "ollama".
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# Free alternative to Anthropic - get a key with no credit card at
# https://aistudio.google.com/apikey, then set AI_PROVIDER=gemini above.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# No external API at all: a model running on your own machine via https://ollama.com. No key,
# no quota, no per-request cost -- just slower than a cloud API. `brew install ollama && ollama
# serve && ollama pull qwen2.5:7b-instruct`, then set AI_PROVIDER=ollama above. In docker-compose,
# OLLAMA_BASE_URL is already wired to the bundled `ollama` container -- leave it unset here.
OLLAMA_MODEL=qwen2.5:7b-instruct

# --- Backend security (CHANGE THESE before deploying anywhere real) ----------
JWT_SECRET=change-me-to-a-long-random-string
APP_ENCRYPTION_KEY=change-me-to-a-long-random-string

# --- Email verification --------------------------------------------------------
# MAIL_PROVIDER=smtp (default) or =sendgrid. Left as smtp with everything below unset,
# docker-compose routes mail to a bundled Mailpit container (SMTP on 1025, web UI at
# http://localhost:8025) so verification emails work out of the box with no real provider
# needed locally.
MAIL_PROVIDER=

# smtp provider: point at a real SMTP server for anything beyond local dev -- e.g. for Gmail:
# MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_USERNAME=you@gmail.com,
# MAIL_PASSWORD=<an app password, not your login password>, MAIL_SMTP_AUTH=true,
# MAIL_SMTP_STARTTLS=true. Note: several PaaS hosts (Railway among them) block outbound SMTP
# entirely on their free tier -- use MAIL_PROVIDER=sendgrid there instead.
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=
MAIL_SMTP_STARTTLS=
MAIL_FROM=no-reply@codepilot.local

# sendgrid provider (MAIL_PROVIDER=sendgrid): calls SendGrid's HTTP API instead of SMTP, so it
# works even where outbound SMTP is blocked. SENDGRID_FROM_ADDRESS must be exactly the address
# verified as a Single Sender at app.sendgrid.com/settings/sender_auth (no domain needed) --
# SendGrid rejects any other "from". Free tier: 100 emails/day.
SENDGRID_API_KEY=
SENDGRID_FROM_ADDRESS=

# --- GitHub OAuth ("Continue with GitHub" login, and the repo picker) --------
# Optional: leave blank to disable. Register an OAuth App at
# https://github.com/settings/developers with callback URL
# http://localhost:8080/api/auth/github/callback (or GITHUB_OAUTH_REDIRECT_URI below).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8080/api/auth/github/callback

# --- Production deployment ------------------------------------------------------
# Left unset, these default to http://localhost:5173 (see docker-compose.yml) -- correct for
# local dev, WRONG for any real deployment. Set both to your real frontend URL before deploying,
# or the backend will reject the frontend's CORS origin and verification-email links will point
# at localhost. Also update GITHUB_OAUTH_REDIRECT_URI above and the frontend's
# VITE_API_BASE_URL (frontend/.env.example) to match your real domain.
CORS_ALLOWED_ORIGIN=
FRONTEND_URL=

# --- Advanced tuning (all optional -- every one has a working default) ----------
# How long a JWT stays valid, in ms. Default 86400000 (24h).
JWT_EXPIRATION_MS=
# How long an email-verification link/code stays valid, in ms. Default 86400000 (24h).
VERIFICATION_TOKEN_EXPIRATION_MS=
# How long a password-reset link stays valid, in ms. Deliberately much shorter than the
# verification window above -- default 3600000 (1h).
PASSWORD_RESET_TOKEN_EXPIRATION_MS=
# SMTP connect/read/write timeouts in ms (MAIL_PROVIDER=smtp only). Without these, a blocked or
# unreachable SMTP host hangs the request indefinitely instead of failing fast. Default 8000 each.
MAIL_SMTP_CONNECTION_TIMEOUT_MS=
MAIL_SMTP_TIMEOUT_MS=
MAIL_SMTP_WRITE_TIMEOUT_MS=
# Use implicit TLS (port 465) instead of STARTTLS (port 587). Default false.
MAIL_SMTP_SSL=
# Per-identity rate limits (Redis-backed; fail open if Redis is briefly down). Set
# RATE_LIMIT_ENABLED=false to disable all of them (not recommended in production). Defaults:
# AI calls 20/60s, search 60/60s, repo-connect 10/3600s, webhook deliveries 120/60s,
# verify-code attempts 10/900s, forgot-password requests 5/3600s.
RATE_LIMIT_ENABLED=
RATE_LIMIT_AI_LIMIT=
RATE_LIMIT_AI_WINDOW_SECONDS=
RATE_LIMIT_SEARCH_LIMIT=
RATE_LIMIT_SEARCH_WINDOW_SECONDS=
RATE_LIMIT_INDEXING_LIMIT=
RATE_LIMIT_INDEXING_WINDOW_SECONDS=
RATE_LIMIT_WEBHOOK_LIMIT=
RATE_LIMIT_WEBHOOK_WINDOW_SECONDS=
RATE_LIMIT_VERIFY_CODE_LIMIT=
RATE_LIMIT_VERIFY_CODE_WINDOW_SECONDS=
RATE_LIMIT_FORGOT_PASSWORD_LIMIT=
RATE_LIMIT_FORGOT_PASSWORD_WINDOW_SECONDS=
