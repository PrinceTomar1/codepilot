server {
    # Railway assigns a dynamic $PORT and proxies to whatever the container actually listens
    # on -- a hardcoded "listen 80" here means Railway's edge can never reach nginx, producing
    # a 502 even though the container itself is healthy. The nginx:alpine image's entrypoint
    # runs envsubst over any *.template file in /etc/nginx/templates/ before starting, so this
    # file is copied there (not straight to conf.d/) and $PORT gets substituted at container
    # startup; PORT defaults to 80 in the Dockerfile for local `docker run` / docker-compose.
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml text/javascript image/svg+xml;

    # SPA routing: any path that isn't a real static file falls back to index.html so
    # React Router's client-side routes (e.g. a deep link to /repositories/{id}) don't 404
    # on a hard refresh -- there is no server-side route for them, only client-side ones.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Hashed build assets (Vite fingerprints filenames) are safe to cache aggressively;
    # index.html itself is deliberately NOT matched here so a new deploy is picked up
    # immediately instead of being served stale from a browser cache.
    location ~* \.(?:css|js|svg|woff2?|ttf|eot|png|jpg|jpeg|gif|ico)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
